<script>
(function(){
  var hdr=document.getElementById('hdr');
  var sentinel=document.getElementById('hdrSentinel');
  if(sentinel&&hdr){
    var io=new IntersectionObserver(function(entries){
      hdr.classList.toggle('scrolled',!entries[0].isIntersecting);
    },{threshold:0});
    io.observe(sentinel);
  }

  var yearEl=document.getElementById('year');
  if(yearEl){yearEl.textContent=new Date().getFullYear();}

  var accs=Array.prototype.slice.call(document.querySelectorAll('.acc'));
  accs.forEach(function(acc){
    var btn=acc.querySelector('.acc-head');
    var panel=acc.querySelector('.acc-panel');
    btn.addEventListener('click',function(){
      if(acc.classList.contains('open')){
        acc.classList.remove('open');
        panel.style.maxHeight='0px';
      }else{
        acc.classList.add('open');
        panel.style.maxHeight=panel.scrollHeight+'px';
      }
    });
  });
  var firstAcc=accs[0];
  if(firstAcc){
    firstAcc.classList.add('open');
    var firstPanel=firstAcc.querySelector('.acc-panel');
    firstPanel.style.maxHeight=firstPanel.scrollHeight+'px';
  }
  window.addEventListener('resize',function(){
    document.querySelectorAll('.acc.open .acc-panel').forEach(function(p){
      p.style.maxHeight=p.scrollHeight+'px';
    });
  });

  var tabs=Array.prototype.slice.call(document.querySelectorAll('.vtab'));
  var featItems=Array.prototype.slice.call(document.querySelectorAll('#featZone [data-v]'));
  var curItems=Array.prototype.slice.call(document.querySelectorAll('#curGrid [data-v]'));
  var userPicked=false;

  function applyTo(list,ver){
    list.forEach(function(el){
      var ok=el.getAttribute('data-v').split(' ').indexOf(ver)>-1;
      el.classList.toggle('version-on',ok);
      el.classList.toggle('version-off',!ok);
    });
  }
  function setVersion(ver,picked){
    if(picked){userPicked=true;}
    tabs.forEach(function(t){t.classList.toggle('active',t.dataset.ver===ver);});
    applyTo(featItems,ver);
    if(userPicked){applyTo(curItems,ver);}
  }
  tabs.forEach(function(t){
    t.addEventListener('click',function(){setVersion(t.dataset.ver,true);});
  });
  setVersion('rs',false);
})();
</script>
</body>
</html>
