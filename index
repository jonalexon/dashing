<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#0b0c10">
<title>Jetour Dashing Ecuador | Grupo Roldán</title>
<meta name="description" content="Jetour Dashing: SUV con diseño premiado internacionalmente, tecnología ADAS y garantía de por vida en el motor. Versiones FULL, LIMITED MT, LIMITED DCT y RS en Ecuador.">
<link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/saira-condensed@5/600.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/saira-condensed@5/700.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/saira-condensed@5/800.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/barlow@5/400.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/barlow@5/500.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/barlow@5/600.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/barlow@5/700.css">
<style>
:root{
  --red:#e10613;
  --red-dark:#b30510;
  --bg-dark:#0b0c10;
  --bg-dark2:#101114;
  --bg-card:#14161c;
  --bg-cell:#0f1116;
  --line-dark:#22252d;
  --line-dark2:#2a2e37;
  --bg-light:#f4f5f7;
  --text:#101114;
  --text-sec:#5d6470;
  --text-sec-dark:#9aa1ad;
  --line-light:#e6e8ec;
  --header-h:60px;
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{font-family:'Barlow','Segoe UI',system-ui,sans-serif;background:var(--bg-light);color:var(--text);-webkit-font-smoothing:antialiased;line-height:1.5}
img{max-width:100%}
.container{width:100%;max-width:1140px;margin:0 auto;padding:0 20px}
section{scroll-margin-top:84px}

/* ===== Topbar ===== */
.topbar{background:var(--red);color:#fff;font-family:'Saira Condensed','Arial Narrow',sans-serif;font-weight:600;font-size:13.5px;letter-spacing:1.4px;text-transform:uppercase;display:flex;align-items:center;justify-content:center;height:36px;padding:0 16px;white-space:nowrap;overflow-x:auto;scrollbar-width:none}
.topbar::-webkit-scrollbar{display:none}

/* ===== Header ===== */
.hdr{position:sticky;top:0;z-index:60;background:#0b0c10;border-bottom:1px solid #1e2127;transition:box-shadow .3s ease}
.hdr.scrolled{box-shadow:0 12px 30px rgba(0,0,0,.5)}
.hdr-in{display:flex;align-items:center;justify-content:space-between;gap:16px;min-height:var(--header-h)}
.brand{display:flex;align-items:baseline;gap:8px;text-decoration:none;font-family:'Saira Condensed','Arial Narrow',sans-serif;font-weight:800;font-size:22px;letter-spacing:1px;line-height:1}
.b-marca{color:#fff}
.b-modelo{color:var(--red)}
.b-pais{color:#9aa1ad;font-size:11px;font-weight:600;letter-spacing:2.5px;text-transform:uppercase}
.nav{display:none;align-items:center;gap:4px}
.nav a{color:#c6ccd6;text-decoration:none;font-weight:600;font-size:14.5px;padding:12px 14px;border-radius:8px;transition:color .25s,background .25s}
.nav a:hover{color:#fff;background:rgba(225,6,19,.14)}
.btn{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:0 26px;border-radius:10px;font-family:'Saira Condensed','Arial Narrow',sans-serif;font-weight:700;font-size:17px;letter-spacing:1.2px;text-transform:uppercase;text-decoration:none;border:1px solid transparent;cursor:pointer;transition:background .3s,border-color .3s,color .3s,transform .3s}
.btn-red{background:var(--red);color:#fff}
.btn-red:hover{background:var(--red-dark)}
.btn-ghost{background:transparent;border-color:rgba(255,255,255,.35);color:#fff}
.btn-ghost:hover{border-color:var(--red);color:#ff8087}
.btn-sm{min-height:44px;padding:0 20px;font-size:15px}

/* ===== Hero ===== */
.hero{position:relative;background:
 radial-gradient(760px 360px at 82% -5%,rgba(225,6,19,.22),transparent 62%),
 radial-gradient(560px 320px at 6% 105%,rgba(225,6,19,.12),transparent 60%),
 #0b0c10;color:#fff;padding:78px 0 60px;overflow:hidden}
.hero::before,.hero::after{content:"";position:absolute;border-radius:50%;border:1px solid rgba(225,6,19,.22);pointer-events:none}
.hero::before{width:380px;height:380px;right:-140px;top:-140px}
.hero::after{width:230px;height:230px;right:-60px;top:-60px;border-color:rgba(225,6,19,.14)}
.hero-inner{position:relative;z-index:2;max-width:840px}
.h1{font-family:'Saira Condensed','Arial Narrow',sans-serif;font-weight:800;font-size:clamp(2rem,4vw,3rem);line-height:1.05;letter-spacing:.5px;text-transform:uppercase;margin:18px 0 16px}
.h1 span{color:var(--red)}
.hero-sub{color:#c6ccd6;font-size:clamp(1rem,1.6vw,1.15rem);line-height:1.65;max-width:680px}
.pill-row{display:flex;flex-wrap:wrap;gap:8px;margin:22px 0 26px}
.pill{background:rgba(225,6,19,.14);border:1px solid rgba(225,6,19,.45);color:#ff8087;font-size:12.5px;font-weight:700;letter-spacing:.8px;text-transform:uppercase;padding:6px 14px;border-radius:999px}
.pill.ghost{background:rgba(255,255,255,.05);border-color:rgba(255,255,255,.22);color:#c6ccd6}
.hero-btns{display:flex;flex-wrap:wrap;gap:12px;margin-top:6px}
.beam-track{position:absolute;left:0;right:0;bottom:0;height:2px;overflow:hidden;z-index:2}
.beam{width:45%;height:100%;background:linear-gradient(90deg,transparent,rgba(225,6,19,.95),transparent);animation:beamMove 5.5s linear infinite}
@keyframes beamMove{from{transform:translateX(-110%)}to{transform:translateX(240%)}}

/* ===== Stats ===== */
.stats{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;background:#22252d;padding:10px;border-radius:16px;margin-top:44px}
.stat{background:#0f1116;border-radius:12px;padding:18px 14px;text-align:center}
.stat-num{font-family:'Saira Condensed','Arial Narrow',sans-serif;font-weight:800;font-size:clamp(1.9rem,3.4vw,2.6rem);color:#fff;line-height:1}
.stat-num span{color:var(--red);font-size:.55em;font-weight:700;margin-left:5px;letter-spacing:.5px}
.stat-lbl{color:#9aa1ad;font-size:12.5px;margin-top:7px;letter-spacing:.3px}

/* ===== Sections ===== */
.section{padding:74px 0}
.section.light{background:var(--bg-light)}
.section.white{background:#fff}
.section.dark{background:radial-gradient(720px 340px at 85% 0%,rgba(225,6,19,.14),transparent 60%),#0b0c10;color:#fff}
.section.dark.alt{background:radial-gradient(720px 340px at 10% 100%,rgba(225,6,19,.12),transparent 60%),#0b0c10;border-top:1px solid #1a1d23}
.sec-head{max-width:780px;margin-bottom:38px}
.kicker{font-family:'Saira Condensed','Arial Narrow',sans-serif;font-weight:700;color:var(--red);letter-spacing:3.5px;text-transform:uppercase;font-size:13px}
.sec-title{font-family:'Saira Condensed','Arial Narrow',sans-serif;font-weight:700;font-size:clamp(1.5rem,3vw,2.25rem);line-height:1.1;margin:8px 0 14px}
.sec-lead{color:var(--text-sec);font-size:16px;line-height:1.65}
.section.dark .sec-lead{color:#9aa1ad}
.sec-line{width:56px;height:4px;background:var(--red);border-radius:2px;margin-top:18px}

/* ===== Presentación ===== */
.present p{color:var(--text-sec);font-size:16.5px;line-height:1.7;max-width:820px}
.present p+p{margin-top:16px}
.present strong{color:var(--text)}
.p-badges{display:flex;flex-wrap:wrap;gap:10px;margin-top:26px}
.p-badge{background:rgba(225,6,19,.09);color:var(--red);font-weight:700;font-size:13.5px;padding:8px 16px;border-radius:999px;letter-spacing:.3px}

/* ===== Curiosos ===== */
.cur-grid{display:grid;gap:24px}
.cur-card{position:relative;background:radial-gradient(circle at 18% -10%,rgba(225,6,19,.14),transparent 55%),#14161c;border:1px solid #22252d;border-left:4px solid var(--red);border-radius:14px;padding:20px;display:flex;flex-direction:column;gap:12px;transition:transform .3s ease,box-shadow .3s ease,border-color .3s ease,opacity .35s ease}
.cur-card:hover{transform:translateY(-4px);box-shadow:0 16px 34px rgba(0,0,0,.45);border-color:#333845}
.cur-ico{width:44px;height:44px;border-radius:50%;background:rgba(225,6,19,.15);display:flex;align-items:center;justify-content:center;font-size:20px;flex:0 0 auto}
.cur-card h3{font-family:'Saira Condensed','Arial Narrow',sans-serif;font-weight:700;font-size:clamp(1.1rem,2vw,1.4rem);color:#fff;line-height:1.15}
.cur-card p{color:#9aa1ad;font-size:14.5px;line-height:1.6}

/* ===== Selector sticky ===== */
.vtab-bar{position:sticky;top:calc(var(--header-h) - 1px);z-index:50;background:#101114;border-bottom:1px solid #2a2e37;box-shadow:0 12px 28px rgba(0,0,0,.28)}
.vtab-in{display:flex;align-items:center;gap:14px}
.vtab-label{font-family:'Saira Condensed','Arial Narrow',sans-serif;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:#9aa1ad;font-size:12.5px;white-space:nowrap}
.vtabs{display:flex;gap:8px;overflow-x:auto;scrollbar-width:none;padding:10px 2px;flex:1}
.vtabs::-webkit-scrollbar{display:none}
.vtab{flex:0 0 auto;min-height:44px;padding:0 22px;border-radius:10px;background:#14161c;border:1px solid #2a2e37;color:#c9ced6;font-family:'Saira Condensed','Arial Narrow',sans-serif;font-weight:600;font-size:16px;letter-spacing:1.2px;cursor:pointer;white-space:nowrap;transition:transform .3s cubic-bezier(.22,.61,.36,1),background .3s,border-color .3s,box-shadow .3s,color .3s}
.vtab:hover{border-color:rgba(225,6,19,.6);color:#fff}
.vtab:active{transform:scale(.96)}
.vtab.active{background:var(--red);border-color:var(--red);color:#fff;transform:scale(1.02);box-shadow:0 8px 20px rgba(225,6,19,.35)}

/* ===== Acordeones ===== */
.feat-lead{color:var(--text-sec);font-size:15.5px;line-height:1.6;max-width:820px;margin:26px 0 24px}
.acc-list{display:flex;flex-direction:column;gap:14px}
.acc{background:#fff;border:1px solid var(--line-light);border-radius:14px;overflow:hidden;box-shadow:0 1px 3px rgba(16,17,20,.05)}
.acc-head{width:100%;display:flex;align-items:center;gap:12px;background:#14161c;color:#fff;border:none;padding:12px 16px;min-height:54px;font-family:'Saira Condensed','Arial Narrow',sans-serif;font-weight:600;font-size:clamp(1.1rem,2vw,1.4rem);cursor:pointer;text-align:left;transition:background .25s}
.acc-head:hover{background:#191c24}
.acc-emoji{font-size:1.15em;line-height:1}
.acc-count{margin-left:auto;font-family:'Barlow',sans-serif;font-size:12px;font-weight:600;color:#9aa1ad;background:#0f1116;border:1px solid #2a2e37;padding:3px 10px;border-radius:999px;white-space:nowrap;letter-spacing:.4px}
.acc-chev{color:var(--red);font-size:1.1em;transition:transform .3s ease;flex:0 0 auto}
.acc.open .acc-chev{transform:rotate(180deg)}
.acc-panel{max-height:0;overflow:hidden;opacity:0;transition:max-height .45s cubic-bezier(.22,.61,.36,1),opacity .35s ease;background:#fff}
.acc.open .acc-panel{opacity:1}
.acc-grid{display:grid;grid-template-columns:1fr;gap:14px;padding:18px}

/* ===== Tarjetas de equipamiento ===== */
.fcard{position:relative;background:#fff;border:1px solid var(--line-light);border-radius:14px;padding:20px;display:flex;flex-direction:column;gap:9px;transition:opacity .35s ease,border-color .35s ease,box-shadow .35s ease,transform .35s ease}
.fcard h4{font-family:'Saira Condensed','Arial Narrow',sans-serif;font-weight:600;font-size:clamp(1.1rem,2vw,1.4rem);line-height:1.15;color:#101114}
.fcard.version-on{border-color:rgba(225,6,19,.35)}
.fcard.version-on:hover{transform:translateY(-3px);box-shadow:0 14px 28px rgba(16,17,20,.1)}
.fcard p{color:var(--text-sec);font-size:14.5px;line-height:1.6}
.fcard p b{color:var(--text)}
.avail{align-self:flex-start;background:rgba(225,6,19,.09);color:var(--red);font-size:11.5px;font-weight:700;letter-spacing:.5px;padding:3px 10px;border-radius:999px;text-transform:uppercase}
.off-badge{display:none;position:absolute;top:14px;right:14px;background:#eef0f3;color:#5d6470;font-size:10.5px;font-weight:700;padding:4px 10px;border-radius:999px;border:1px solid var(--line-light);letter-spacing:.3px;white-space:nowrap}
.fcard.version-off{opacity:.35;pointer-events:none;border-color:var(--line-light);box-shadow:none;transform:none}
.fcard.version-off .off-badge{display:inline-block}
.fcard.version-off h4{padding-right:140px}
.wide{grid-column:1/-1}
.note{grid-column:1/-1;background:rgba(225,6,19,.06);border-left:4px solid var(--red);border-radius:10px;padding:12px 16px;color:#3c414b;font-size:14px;line-height:1.55}
.colors{display:flex;flex-wrap:wrap;gap:18px;margin-top:6px}
.color-chip{display:flex;flex-direction:column;align-items:center;gap:6px}
.dot{width:34px;height:34px;border-radius:50%;border:1px solid var(--line-light);box-shadow:inset 0 0 0 2px #fff}
.color-chip span{font-size:11.5px;font-weight:600;color:var(--text-sec);letter-spacing:.3px}

/* ===== Tabla comparativa ===== */
.tbl-wrap{background:#fff;border:1px solid var(--line-light);border-radius:14px;overflow:hidden;box-shadow:0 2px 12px rgba(16,17,20,.05)}
.tbl-scroll{overflow-x:auto;scrollbar-width:none}
.tbl-scroll::-webkit-scrollbar{display:none}
table{width:100%;min-width:780px;border-collapse:collapse;font-size:14.5px}
th,td{padding:12px 14px;border-bottom:1px solid var(--line-light);text-align:center}
th{font-family:'Saira Condensed','Arial Narrow',sans-serif;font-weight:700;font-size:15.5px;letter-spacing:.8px;background:#101114;color:#fff;text-transform:uppercase}
th:first-child,td:first-child{text-align:left}
td:first-child{font-weight:600;color:#101114;background:#fafbfc}
.cmp td:nth-child(5){background:rgba(225,6,19,.06)}
.cmp th:nth-child(5){background:var(--red)}
tbody tr:last-child td{border-bottom:none}
.yes{color:var(--red);font-weight:700}
.no{color:#b7bdc7}
.tbl-note{margin-top:14px;color:var(--text-sec);font-size:13px}
.dim-strip{display:flex;flex-wrap:wrap;gap:10px;margin-top:22px}
.dim{background:#fff;border:1px solid var(--line-light);border-radius:999px;padding:8px 16px;font-size:13.5px;font-weight:600;color:#3c414b}
.dim b{color:var(--red);font-family:'Saira Condensed','Arial Narrow',sans-serif;font-size:15px;letter-spacing:.5px;margin-right:4px}

/* ===== Perfiles ===== */
.prof-grid{display:grid;gap:20px}
.prof-card{background:#101114;border:1px solid #2a2e37;border-radius:14px;padding:24px;display:flex;flex-direction:column;gap:14px;transition:transform .3s ease,border-color .3s ease,box-shadow .3s ease}
.prof-card:hover{transform:translateY(-4px);border-color:var(--red);box-shadow:0 16px 34px rgba(0,0,0,.45)}
.prof-top{display:flex;align-items:center;gap:12px}
.prof-ico{width:46px;height:46px;border-radius:50%;background:rgba(225,6,19,.1);display:flex;align-items:center;justify-content:center;font-size:21px;flex:0 0 auto}
.prof-card h3{font-family:'Saira Condensed','Arial Narrow',sans-serif;font-weight:700;font-size:clamp(1.1rem,2vw,1.4rem);color:#fff;line-height:1.1}
.prof-badge{align-self:flex-start;background:rgba(225,6,19,.12);border:1px solid rgba(225,6,19,.45);color:var(--red);font-size:11.5px;font-weight:700;letter-spacing:.8px;text-transform:uppercase;padding:4px 12px;border-radius:999px}
.prof-card>p{color:#9aa1ad;font-size:14.5px;line-height:1.6}
.prof-list{list-style:none;display:flex;flex-direction:column;gap:9px}
.prof-list li{position:relative;padding-left:19px;color:#c6ccd6;font-size:14px;line-height:1.5}
.prof-list li::before{content:"";position:absolute;left:0;top:7px;width:8px;height:8px;border-radius:50%;background:var(--red)}

/* ===== Respaldo ===== */
.r-stats{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;background:#22252d;padding:10px;border-radius:16px;margin-bottom:36px}
.r-stat{background:#0f1116;border-radius:12px;padding:18px 14px;text-align:center}
.r-stat .num{font-family:'Saira Condensed','Arial Narrow',sans-serif;font-weight:800;font-size:clamp(1.7rem,3vw,2.3rem);color:#fff;line-height:1}
.r-stat .num em{font-style:normal;color:var(--red);font-size:.6em;font-weight:700}
.r-stat .lbl{color:#9aa1ad;font-size:12.5px;margin-top:6px}
.resp-grid{display:grid;gap:20px}
.resp-card{background:#14161c;border:1px solid #2a2e37;border-radius:14px;padding:24px;transition:transform .3s ease,border-color .3s ease,box-shadow .3s ease}
.resp-card:hover{transform:translateY(-4px);border-color:rgba(225,6,19,.6);box-shadow:0 16px 34px rgba(0,0,0,.45)}
.resp-ico{width:46px;height:46px;border-radius:50%;background:rgba(225,6,19,.15);display:flex;align-items:center;justify-content:center;font-size:21px;margin-bottom:14px}
.resp-card h3{font-family:'Saira Condensed','Arial Narrow',sans-serif;font-weight:700;font-size:clamp(1.1rem,2vw,1.4rem);color:#fff;margin-bottom:10px}
.resp-card p{color:#9aa1ad;font-size:14.5px;line-height:1.65}
.resp-card .fine{display:block;margin-top:12px;font-size:12.5px;color:#6b7280}

/* ===== Footer ===== */
.footer{background:#07080b;color:#9aa1ad;padding:44px 0;border-top:1px solid #1a1d23}
.footer-in{display:flex;flex-direction:column;gap:22px}
.footer .brand{font-size:20px}
.footer-tag{font-size:13.5px;line-height:1.6;max-width:520px;margin-top:10px}
.footer-col h4{font-family:'Saira Condensed','Arial Narrow',sans-serif;color:#fff;font-weight:700;font-size:16px;letter-spacing:1px;text-transform:uppercase;margin-bottom:8px}
.footer-col p{font-size:13.5px;line-height:1.65}
.footer-bottom{margin-top:30px;padding-top:20px;border-top:1px solid #15181e;font-size:12.5px;line-height:1.6;color:#6b7280}

/* ===== Estados de versión ===== */
.version-off{opacity:.35;pointer-events:none}

/* ===== Focus visible ===== */
.vtab:focus-visible,.acc-head:focus-visible,.btn:focus-visible,a:focus-visible{outline:2px solid var(--red);outline-offset:2px}

/* ===== Responsive ===== */
@media(min-width:560px){
  .stats{grid-template-columns:repeat(3,1fr)}
}
@media(min-width:640px){
  .cur-grid{grid-template-columns:repeat(2,1fr)}
  .prof-grid{grid-template-columns:repeat(2,1fr)}
}
@media(min-width:760px){
  .acc-grid{grid-template-columns:1fr 1fr}
  .stats{grid-template-columns:repeat(3,1fr)}
  .resp-grid{grid-template-columns:repeat(3,1fr)}
  .r-stats{grid-template-columns:repeat(4,1fr)}
}
@media(min-width:900px){
  .nav{display:flex}
}
@media(min-width:1000px){
  .stats{grid-template-columns:repeat(6,1fr)}
}
@media(min-width:1024px){
  .cur-grid{grid-template-columns:repeat(3,1fr)}
}
@media(min-width:1160px){
  .prof-grid{grid-template-columns:repeat(4,1fr)}
}
@media(max-width:899px){
  .vtab-label{display:none}
}
@media(max-width:640px){
  .acc-count{display:none}
  .section{padding:58px 0}
}
@media(prefers-reduced-motion:reduce){
  *,*::before,*::after{animation:none!important;transition:none!important}
  html{scroll-behavior:auto}
}
</style>
</head>
<body>

<div class="topbar">Grupo Roldán · Jetour · JAC · SANY · YTO · Karry · Textron · Zongshen · +50 años · 27 concesionarios</div>

<div id="hdrSentinel"></div>
<header class="hdr" id="hdr">
  <div class="container hdr-in">
    <a href="#top" class="brand"><span class="b-marca">JETOUR</span><span class="b-modelo">DASHING</span><span class="b-pais">Ecuador</span></a>
    <nav class="nav">
      <a href="#modelo">El modelo</a>
      <a href="#detalles">Detalles</a>
      <a href="#equipamiento">Equipamiento</a>
      <a href="#perfiles">Versiones</a>
      <a href="#respaldo" class="btn btn-red btn-sm">Respaldo</a>
    </nav>
  </div>
</header>

<main id="top">

<!-- HERO -->
<section class="hero">
  <div class="container">
    <div class="hero-inner">
      <div class="pill-row">
        <span class="pill">SUV</span>
        <span class="pill ghost">Plataforma Kunlun</span>
        <span class="pill ghost">4 versiones</span>
        <span class="pill">Garantía de por vida en el motor</span>
      </div>
      <h1 class="h1">Jetour <span>Dashing</span></h1>
      <p class="hero-sub">El SUV que eleva el estándar de su categoría: un diseño premiado internacionalmente, tecnología que cuida de los tuyos y un respaldo que ninguna otra marca te ofrece en Ecuador.</p>
